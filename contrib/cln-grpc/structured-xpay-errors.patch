+// Preserve the existing typed JSON-RPC origin. Socket/decode failures have
+// code=None and must remain ambiguous. No terminal-payment claim is made here.
+fn xpay_rpc_error(error: cln_rpc::primitives::RpcError) -> Status {
+    let mut status = Status::new(Code::Unknown, format!("Error calling method Xpay: {:?}", error));
+    if let Some(code) = error.code {
+        if let Ok(value) = code.to_string().parse() {
+            status.metadata_mut().insert("abandon-cln-jsonrpc-error-code", value);
+        }
+    }
+    status
+}
 
 
