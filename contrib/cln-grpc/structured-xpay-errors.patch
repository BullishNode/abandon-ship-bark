+#[cfg(test)]
+mod xpay_error_tests {
+    use super::*;
+
+    fn error(code: Option<i32>) -> cln_rpc::primitives::RpcError {
+        cln_rpc::primitives::RpcError { code, message: "test failure".into(), data: None }
+    }
+
+    #[test]
+    fn xpay_jsonrpc_error_survives_grpc_status_encoding() {
+        let status = xpay_rpc_error(error(Some(205)));
+        let response = status.into_http::<()>();
+        let decoded = Status::from_header_map(response.headers()).unwrap();
+        assert_eq!(decoded.code(), Code::Unknown);
+        assert_eq!(decoded.metadata().get("abandon-cln-jsonrpc-error-code").unwrap(), "205");
+    }
+
+    #[test]
+    fn xpay_socket_or_decode_error_has_no_jsonrpc_receipt() {
+        let response = xpay_rpc_error(error(None)).into_http::<()>();
+        let decoded = Status::from_header_map(response.headers()).unwrap();
+        assert!(decoded.metadata().get("abandon-cln-jsonrpc-error-code").is_none());
+    }
+
+    #[test]
+    fn xpay_in_progress_error_is_not_a_terminal_assertion() {
+        let response = xpay_rpc_error(error(Some(200))).into_http::<()>();
+        let decoded = Status::from_header_map(response.headers()).unwrap();
+        assert_eq!(decoded.metadata().get("abandon-cln-jsonrpc-error-code").unwrap(), "200");
+        assert!(decoded.metadata().get("abandon-cln-terminal").is_none());
+    }
+}
